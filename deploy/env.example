# /opt/hidl/.env on the server. Never commit the real file.
HIDL_DOMAIN=169-58-96-52.sslip.io
# Host port for a reverse proxy on the server itself (bound to 127.0.0.1 only).
HIDL_PORT=3000
ALLOWED_EMAIL=*
# Emails that are admins (the /admin panel) the moment they sign in; comma-separate several.
ADMIN_EMAIL=
SUPER_ADMIN_EMAIL=
SUPABASE_SECRET_KEY=
# The admin Analytics tab (optional): a PostHog personal API key with query:read, and the project id.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
ENABLE_UNLOCK_EMAILS=false
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM="hidl <letters@hidl.fetehadin.com>"
# Where the server's alerts and reports (disk space, backups, orphan files) are emailed.
REPORT_EMAIL=

# Photo and video files (docs/storage.md). media/setup-garage.sh fills in the S3_* values and the
# key; STORAGE_PROVIDER is switched by hand: supabase (Supabase Storage) or s3 (Garage on this server).
STORAGE_PROVIDER=supabase
COMPOSE_PROFILES=media
S3_PUBLIC_URL=https://media.fetehadin.com
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=hidl-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The bucket's size limit (37 GiB), shown on the admin panel.
MEDIA_CAPACITY_BYTES=39728447488
# For the server's tools (media/run-tool.sh): the same value as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
