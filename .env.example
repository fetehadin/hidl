# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: `pnpm db:start` prints local values; in production use
# Project Settings → API Keys in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public URL of the app (used in magic links). Your Vercel domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated list of emails allowed to sign in. Everyone else is turned away.
# Set to "*" to let anyone sign up (each person gets their own isolated journal).
ALLOWED_EMAIL=you@example.com

# Optional. Comma-separated emails that become admins (the /admin panel) as soon as they sign in.
# Regular admins see numbers and feedback; super admins can also suspend/delete accounts and manage admins.
ADMIN_EMAIL=you@example.com
SUPER_ADMIN_EMAIL=

# Server-only. Used by integration tests (local Supabase), account deletion, and the unlock-email cron.
# Never expose this to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Optional: "Continue with Google" through hidl's own address ---
# The same Google OAuth client ("hidl web") that Supabase's Google provider uses. With both set, Google's
# screen says "continue to hidl" (or your domain until Google verifies the branding) instead of
# <project-ref>.supabase.co. Server only. Unset: Supabase's own Google flow, as before.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: CAPTCHA on the login form (Cloudflare Turnstile) ---
# Leave unset in local dev to skip the widget. The secret key lives in Supabase's Auth
# config (Authentication → Attack Protection), never here — the app only needs the site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Optional: product analytics (PostHog) ---
# The project token is public and write-only; unset turns analytics off. Production sets it as a
# GitHub repository variable (it's inlined at build time).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server only, for the admin Analytics tab: a personal API key with the query:read scope.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# --- Photo and video files (docs/storage.md) ---
# supabase (default): the private `photos` bucket in Supabase Storage.
# s3: an S3-compatible store (Garage on the VPS in production); then set the S3_* values too.
STORAGE_PROVIDER=supabase
# What browsers use (links are signed for it) and, optionally, what the server uses itself.
S3_PUBLIC_URL=http://127.0.0.1:3910
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET=hidl-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The store's size limit in bytes, for the admin panel (1 GiB when unset with Supabase).
MEDIA_CAPACITY_BYTES=

# --- Optional: email me when a letter unlocks (daily Vercel Cron, 08:00 Addis) ---
# Off unless this is exactly "true".
ENABLE_UNLOCK_EMAILS=false
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes. Use 32+ random chars.
CRON_SECRET=
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "hidl <letters@yourdomain.com>"
EMAIL_FROM=
