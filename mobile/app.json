{
  "expo": {
    "name": "hidl",
    "slug": "hidl",
    "owner": "fetebuild",
    "scheme": "hidl",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.hidl.mobile"
    },
    "android": {
      "package": "app.hidl.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#c8e6e2",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Nunito-ExtraBold.ttf",
            "./assets/fonts/Nunito-Black.ttf",
            "./assets/fonts/JetBrainsMono-Bold.ttf"
          ],
          "widgets": [
            {
              "name": "CountdownSmall",
              "label": "hidl countdown · small",
              "description": "Hidi and the big number. Tap to flip.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget/preview-small.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "Countdown",
              "label": "hidl countdown",
              "description": "Your countdowns, soonest first, with arrows to flip.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget/preview-medium.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "CountdownLarge",
              "label": "hidl countdowns · large",
              "description": "Hidi up top and a list of every countdown.",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "previewImage": "./assets/widget/preview-large.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            }
          ]
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "98fba00e-9373-4564-b086-b41a8842f2aa"
      },
      "siteUrl": "https://hidl.fetehadin.com"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/98fba00e-9373-4564-b086-b41a8842f2aa",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
