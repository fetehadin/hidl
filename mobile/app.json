{
  "expo": {
    "name": "Hidl",
    "slug": "hidl",
    "owner": "fetebuild",
    "scheme": "hidl",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.hidl.mobile"
    },
    "android": {
      "package": "app.hidl.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#c8e6e2",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Nunito-ExtraBold.ttf",
            "./assets/fonts/Nunito-Black.ttf",
            "./assets/fonts/JetBrainsMono-Bold.ttf"
          ],
          "widgets": [
            {
              "name": "CountdownSmall",
              "label": "Hidl countdown · small",
              "description": "Hidi and the big number. Tap for the next one.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget/preview-small.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "CountdownTall",
              "label": "Hidl countdown · tall",
              "description": "Hidi big, the number below. Tap to flip.",
              "minWidth": "110dp",
              "minHeight": "180dp",
              "targetCellWidth": 2,
              "targetCellHeight": 3,
              "previewImage": "./assets/widget/preview-tall.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "Countdown",
              "label": "Hidl countdown",
              "description": "Your countdowns as a stack of cards. Tap to flip.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget/preview-medium.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "CountdownLarge",
              "label": "Hidl countdowns · large",
              "description": "Hidi with your next countdown, and the ones after it.",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "previewImage": "./assets/widget/preview-large.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            }
          ]
        }
      ],
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "photosPermission": "Hidl shows your recent photos so you can add them to your journal.",
          "savePhotosPermission": "Hidl saves pictures you share from it.",
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hidl shows your photos so you can add them to your journal.",
          "cameraPermission": "Hidl uses the camera to take a photo for your journal."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "98fba00e-9373-4564-b086-b41a8842f2aa"
      },
      "siteUrl": "https://hidl.fetehadin.com"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/98fba00e-9373-4564-b086-b41a8842f2aa",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
