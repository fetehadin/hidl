{
  "expo": {
    "name": "hidl",
    "slug": "hidl",
    "owner": "fetebuild",
    "scheme": "hidl",
    "version": "0.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.hidl.mobile"
    },
    "android": {
      "package": "app.hidl.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#c8e6e2",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Countdown",
              "label": "hidl countdown",
              "description": "Time left on one of your hidl countdowns",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "98fba00e-9373-4564-b086-b41a8842f2aa"
      },
      "siteUrl": "https://hidl.fetehadin.com"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/98fba00e-9373-4564-b086-b41a8842f2aa",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
